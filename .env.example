KOSTAL_HOST=192.168.178.10
KOSTAL_PROTOCOL=http
KOSTAL_PORT=80
KOSTAL_INTERVAL=10
OUTPUT_TARGET=influxdb

INFLUX_SCHEMA=http
INFLUX_HOST=localhost
INFLUX_PORT=8086
INFLUX_TOKEN=replace_me
INFLUX_ORG=replace_me
INFLUX_BUCKET=replace_me
INFLUX_MEASUREMENT_KOSTAL=replace_me

MQTT_HOST=localhost
MQTT_PORT=1883
#MQTT_USERNAME=
#MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=kostal
MQTT_RETAIN=false

